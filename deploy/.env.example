# Copy to .env next to docker-compose.yml. Never commit .env.

# Public hostnames (DNS A records pointing at this host). Caddy gets certificates for them.
STUDIO_HOST=studio.example.com
API_HOST=api.example.com
AUTH_HOST=auth.example.com
ACME_EMAIL=ops@example.com

# Postgres. The superuser is used by the first-start init script and by the
# backup service (so dumps see every row, whatever RLS and ownership say).
POSTGRES_SUPERUSER_PASSWORD=change-me
APP_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak admin console (https://AUTH_HOST/admin).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Who may open it: CIDRs, space-separated (your office, VPN or bastion; your own
# address as a /32 for a one-off). Caddy answers 403 to everyone else, and the
# list is the only way in. Empty = nobody. Applied when the caddy container
# starts: `docker compose up -d caddy` after a change (README, Deploying).
ADMIN_ALLOW_CIDRS=

# Backend secrets. Generate each with: openssl rand -hex 32
PREVIEW_TOKEN_SECRET=
# Encrypts apps' visitor-signing secrets at rest (AES-256-GCM). Losing it
# means every app has to generate a new signing secret.
SECRETS_KEY=
# Bearer token for GET /metrics (Prometheus). Leave empty and the endpoint
# answers 404. Required by the `monitoring` compose profile, which reads it too.
METRICS_TOKEN=
# Where the `monitoring` profile's Alertmanager POSTs firing alerts: a Slack,
# Teams, PagerDuty, Opsgenie, ... "Prometheus/Alertmanager" integration URL.
# Mounted into the container as a secret file, never written into the config.
ALERT_WEBHOOK_URL=

# Invitation emails (optional). Unset: invitations are links the inviter copies.
# smtp://user:pass@host:587 or smtps://…; MAIL_FROM is required with SMTP_URL.
SMTP_URL=
MAIL_FROM=
# Error tracking (optional): every 5xx goes to Sentry when set.
SENTRY_DSN=

# Images (defaults: the ones CI pushes to GHCR on main).
#BACKEND_IMAGE=ghcr.io/mohanvegi4/guide/backend:latest
#STUDIO_IMAGE=ghcr.io/mohanvegi4/guide/studio:latest
#BACKEND_REPLICAS=1

# Tuning
#AGENT_RATE_LIMIT_PER_MIN=600
#EVENT_RETENTION_DAYS=400

# Backups (the `backup` service: pg_dump of guide_engine and keycloak into ./backups).
# Daily run time, HH:MM in UTC, and how many days of dumps to keep.
#BACKUP_AT=03:00
#BACKUP_KEEP_DAYS=14
# Optional off-host copy, run inside the backup container after each dump
# with the dump's path as $1. The postgres image has no rclone/aws: mount
# the binary and its config in a compose override, or leave this unset and
# sync ./backups from the host instead (a cron job on the host).
#BACKUP_COPY_CMD=rclone copy "$1" remote:guide-engine-backups
