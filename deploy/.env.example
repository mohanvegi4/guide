# Copy to .env next to docker-compose.yml. Never commit .env.

# Public hostnames (DNS A records pointing at this host). Caddy gets certificates for them.
STUDIO_HOST=studio.example.com
API_HOST=api.example.com
AUTH_HOST=auth.example.com
ACME_EMAIL=ops@example.com

# Postgres. The superuser is used only by the first-start init script.
POSTGRES_SUPERUSER_PASSWORD=change-me
APP_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak admin console (https://AUTH_HOST/admin).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Backend secrets. Generate each with: openssl rand -hex 32
PREVIEW_TOKEN_SECRET=
# Encrypts apps' visitor-signing secrets at rest (AES-256-GCM). Losing it
# means every app has to generate a new signing secret.
SECRETS_KEY=

# Images (defaults: the ones CI pushes to GHCR on main).
#BACKEND_IMAGE=ghcr.io/mohanvegi4/guide/backend:latest
#STUDIO_IMAGE=ghcr.io/mohanvegi4/guide/studio:latest
#BACKEND_REPLICAS=1

# Tuning
#AGENT_RATE_LIMIT_PER_MIN=600
#EVENT_RETENTION_DAYS=400
