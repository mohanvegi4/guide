{
  "name": "guide-engine",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "npm run build --workspace=packages/backend && npm run migrate --workspace=packages/backend",
    "idp:up": "docker compose --profile sso up -d --wait keycloak",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
