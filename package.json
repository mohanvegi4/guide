{
  "name": "guide-engine",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspace=e2e",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:studio": "npm run dev --workspace=apps/studio",
    "dev:demo": "npm run dev --workspace=apps/demo",
    "db:up": "docker compose -f docker/docker-compose.yml --project-directory . up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml --project-directory . --profile sso down",
    "migrate": "npm run build --workspace=apps/backend && npm run migrate --workspace=apps/backend",
    "idp:up": "docker compose -f docker/docker-compose.yml --project-directory . --profile sso up -d --wait keycloak"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
