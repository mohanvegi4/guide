{
  "name": "@guide-engine/backend",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "mint-token": "node dist/scripts/mint-token.js",
    "sign-identity": "node dist/scripts/sign-identity.js",
    "seed": "node dist/scripts/seed.js",
    "retention": "node dist/scripts/retention.js",
    "encrypt-secrets": "node dist/scripts/encrypt-secrets.js"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "pg": "^8.12.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.3"
  }
}
