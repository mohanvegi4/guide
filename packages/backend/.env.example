DATABASE_URL=postgres://guide_engine:guide_engine@localhost:5433/guide_engine
PORT=3000
NODE_ENV=development
# Where browsers reach this API — goes into install snippets (the agent script URL).
PUBLIC_API_URL=http://localhost:3000

# Studio sign-in (OpenID Connect). Required outside development.
# The provider is used for identity only (sub / email / name); organizations
# and roles live in Guide Engine's own database.
#   local Keycloak: `npm run idp:up` -> OIDC_ISSUER=http://localhost:8081/realms/guide-engine
OIDC_ISSUER=
OIDC_AUDIENCE=guide-engine-api
# Optional: skip discovery and use this JWKS URL directly.
OIDC_JWKS_URI=
# Public (no secret) client the Studio uses for Authorization Code + PKCE.
OIDC_STUDIO_CLIENT_ID=guide-studio
OIDC_STUDIO_SCOPE=openid profile email

# DEVELOPMENT ONLY: HS256 secret for Studio dev tokens (npm run mint-token / seed),
# honoured only when NODE_ENV is development or test. Generate: openssl rand -hex 32
JWT_SECRET=

# Signed preview links. Must differ from JWT_SECRET; leave empty to disable preview.
PREVIEW_TOKEN_SECRET=

# Agent API rate limit per app key + client IP, per minute.
AGENT_RATE_LIMIT_PER_MIN=600
# Where the limit is counted: memory (one process; default in development)
# or postgres (shared by every replica; the default, and required, in production).
RATE_LIMIT_STORE=memory
# Set to true behind a reverse proxy so rate limiting sees real client IPs.
TRUST_PROXY=false

# Encrypts apps' visitor-signing secrets at rest (AES-256-GCM). Required in
# production. Generate: openssl rand -hex 32. After turning it on, run
# `npm run encrypt-secrets` once to re-write secrets stored earlier.
SECRETS_KEY=

# Delete guide events older than this many days (daily job; also `npm run retention`).
# Unset: 400 days in production, off elsewhere. 0 = off.
EVENT_RETENTION_DAYS=

# Observability. Logs are JSON lines on stdout (LOG_LEVEL: trace..fatal, default info).
LOG_LEVEL=info
# GET /metrics (Prometheus) is served only with `Authorization: Bearer <METRICS_TOKEN>`.
# Unset: open in development/test, absent (404) elsewhere. Generate: openssl rand -hex 32
METRICS_TOKEN=
# Optional error tracking: set a Sentry DSN to report 5xx errors (tagged with the request id).
SENTRY_DSN=
