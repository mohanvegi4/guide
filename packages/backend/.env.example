DATABASE_URL=postgres://guide_engine:guide_engine@localhost:5433/guide_engine
PORT=3000
NODE_ENV=development

# HS256 signing secret for bearer tokens (>= 32 chars). Generate with:
#   openssl rand -hex 32
JWT_SECRET=
# Optional: when set, tokens must carry a matching iss / aud claim.
JWT_ISSUER=
JWT_AUDIENCE=

# Signed preview links. Must differ from JWT_SECRET; leave empty to
# disable preview. PREVIEW_APP_BASE_URL is the host product the link opens.
PREVIEW_TOKEN_SECRET=
PREVIEW_APP_BASE_URL=http://localhost:5174

# Comma-separated origins allowed to call the API from a browser (the host
# apps embedding the SDK). Leave empty for same-origin only.
CORS_ORIGINS=

# DEV ONLY — accepts raw "tenantId:userId[:role]" bearer tokens. Refused at boot
# unless NODE_ENV is development or test. See src/auth/config.ts.
GUIDE_ENGINE_DEV_AUTH=false

# Single sign-on (OpenID Connect). Leave OIDC_ISSUER empty to disable.
# Tokens are verified against the provider's JWKS (discovered from the issuer).
#   local mock provider: `npm run idp:up` -> OIDC_ISSUER=http://localhost:8080/default
OIDC_ISSUER=
OIDC_AUDIENCE=guide-engine-api
# Optional: skip discovery and use this JWKS URL directly.
OIDC_JWKS_URI=
# Where our claims live in the provider's tokens (dot paths allowed, e.g. realm_access.roles).
OIDC_TENANT_CLAIM=tenantId
OIDC_USER_CLAIM=sub
OIDC_ROLES_CLAIM=roles
# Public (no secret) client the Studio uses for Authorization Code + PKCE.
OIDC_STUDIO_CLIENT_ID=guide-studio
OIDC_STUDIO_SCOPE=openid profile
